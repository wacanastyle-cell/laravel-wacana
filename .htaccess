<IfModule mod_rewrite.c>
    RewriteEngine On

    # Jangan rewrite folder public ke dirinya sendiri
    RewriteRule ^public(?:/|$) - [L]

    # File/folder yang memang ada di public dilayani langsung
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.+)$ public/$1 [L]

    # Semua request Laravel masuk melalui public/index.php
    RewriteRule ^ public/index.php [L]
</IfModule>

